# Application
APP_NAME=OpsPilot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM provider (OpenAI-compatible API or local inference server)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opspilot_chunksQDRANT_PATH=data/index/qdrant

# Day 4 local baseline / production replacement
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Day 5 generation: mock, openai-compatible, or a local vLLM/Ollama endpoint
GENERATION_PROVIDER=mock
GENERATION_TIMEOUT_SECONDS=60
GENERATION_RETRIES=2

# Request and retrieval settings
REQUEST_TIMEOUT_SECONDS=60
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_RERANK=5

