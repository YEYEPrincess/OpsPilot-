# Application
APP_NAME=OpsPilot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM provider (OpenAI-compatible API or local inference server)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opspilot_chunks

# Request and retrieval settings
REQUEST_TIMEOUT_SECONDS=60
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_RERANK=5

